# Normalize to LF in the repo, check out native on each platform.
* text=auto

# These must keep specific endings regardless of platform.
*.bat    text eol=crlf
gradlew  text eol=lf
*.sh     text eol=lf

# Never touch binaries.
*.jar      binary
*.apk      binary
*.aab      binary
*.keystore binary
*.png      binary
*.jpg      binary
*.webp     binary
